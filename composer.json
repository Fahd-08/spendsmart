{
    "name": "fahd-08/spendsmart",
    "description": "SpendSmart - budgettool (MVP) voor MoneyMinds",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --no-coverage",
        "test:coverage": "@php -d extension=tools/pcov.so -d pcov.enabled=1 vendor/bin/phpunit"
    },
    "scripts-descriptions": {
        "test": "Alle tests draaien (zonder coverage)",
        "test:coverage": "Alle tests draaien en het coverage-rapport maken in coverage/"
    }
}
